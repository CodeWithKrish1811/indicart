# =============================================================================
# Indicart Environment Configuration Template
# Copy this file to '.env' or '.env.local' for local development:
#   cp .env.example .env
#
# DO NOT commit real secrets or production credentials to version control.
# Real '.env*' files are ignored by git (.gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# Base URL for custom backend or REST API endpoints (Axios client in src/services/api.js).
# Default: Leave empty to use direct relative paths or default external catalog (DummyJSON).
VITE_API_BASE_URL=

# -----------------------------------------------------------------------------
# Firebase Configuration
# Optional: Override default applet credentials (from firebase-applet-config.json)
# with your own Firebase project credentials for authentication and Cloud Firestore.
# -----------------------------------------------------------------------------
# Firebase Web API Key
VITE_FIREBASE_API_KEY=

# Firebase Auth Domain (e.g., your-project-id.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN=

# Firebase Project ID (e.g., your-project-id)
VITE_FIREBASE_PROJECT_ID=

# Firebase Cloud Storage Bucket URL (e.g., your-project-id.firebasestorage.app)
VITE_FIREBASE_STORAGE_BUCKET=

# Firebase Cloud Messaging Sender ID (numeric sender ID)
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Firebase Web App ID (e.g., 1:123456789:web:abcdef)
VITE_FIREBASE_APP_ID=

# Optional: Google Analytics Measurement ID (e.g., G-XXXXXXXXXX)
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: Dedicated Firestore Database ID (leave blank to use the '(default)' database)
VITE_FIREBASE_FIRESTORE_DATABASE_ID=